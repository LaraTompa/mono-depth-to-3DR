#!/bin/bash
#SBATCH --job-name="depthalign-train"
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1,VRAM:24G
#SBATCH --mem=32G
#SBATCH --time=8:00:00
#SBATCH --part=PRACT
#SBATCH --qos=practical_course
#SBATCH --mail-type=ALL
#SBATCH --mail-user=slurmbot-!NdJrGnTMxjelpwkoRL:tum.de@vision.in.tum.de,s0012
#SBATCH --output=/usr/prakt/s0012/slurm/logs/slurm-%j.out
#SBATCH --error=/usr/prakt/s0012/slurm/logs/slurm-%j.err

pwd; hostname; date
echo "Job ID: $SLURM_JOB_ID"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate mono-depth-3dr

nvidia-smi
echo "Python: $(which python)"
echo "PyTorch: $(python -c 'import torch; print(torch.__version__)')"
echo "CUDA available: $(python -c 'import torch; print(torch.cuda.is_available())')"

cd /usr/prakt/s0012/mono-depth-to-3DR

python training/train.py \
    --config config/training.yaml \
    --arch   config/arch.yaml \
    --resume checkpoints/last.pt

echo "Done: $(date)"